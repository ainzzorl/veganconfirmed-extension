{
  "manifest_version": 3,
  "name": "Vegan Confirmed",
  "version": "2.0.2",
  "description": "Vegan shopping assistant",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "*://www.google.com/maps/*",
        "*://maps.google.com/*",
        "*://www.google.co.uk/maps/*",
        "*://www.google.ca/maps/*",
        "*://www.google.com.au/maps/*",
        "*://www.google.de/maps/*",
        "*://www.google.fr/maps/*",
        "*://www.google.es/maps/*",
        "*://www.google.it/maps/*",
        "*://www.google.nl/maps/*",
        "*://www.google.pl/maps/*",
        "*://www.google.se/maps/*",
        "*://www.google.com.br/maps/*",
        "*://www.google.co.in/maps/*",
        "*://www.google.co.jp/maps/*"
      ],
      "js": [
        "maps.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf_extract.mjs",
        "vendor/pdf.min.mjs",
        "vendor/pdf.worker.min.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "veganconfirmed@gmail.com"
    }
  }
}