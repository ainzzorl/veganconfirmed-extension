# AMO credentials for `make deploy-firefox`. Copy to .env and fill in with a
# key pair from https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=

# Chrome Web Store credentials for `make deploy-chrome`. EXTENSION_ID and
# PUBLISHER_ID are the item ID and account ID in the Developer Dashboard URL;
# the OAuth client and refresh token come from
# https://github.com/fregante/chrome-webstore-upload-keys
EXTENSION_ID=
PUBLISHER_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
